# Salin file ini menjadi ".env" lalu isi nilainya.
# File .env TIDAK boleh di-commit (sudah ada di backend/.gitignore).

# Connection string dari dashboard Neon (Connection Details → pilih "Node.js"/"psql").
# Contoh bentuknya: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=

# String acak panjang untuk menandatangani JWT. Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Port server lokal.
PORT=3000

# Origin frontend yang boleh memanggil API langsung (dipisah koma).
# 5500 = Live Server (frontend-vanilla). React memakai proxy Vite sehingga tidak perlu CORS.
CORS_ORIGIN=http://localhost:5500

# development | production  (production → cookie diberi flag Secure)
NODE_ENV=development

# lax (default, dipakai bila frontend & API satu situs / lewat proxy)
# none (hanya jika frontend memanggil API di domain lain secara langsung; wajib HTTPS)
COOKIE_SAMESITE=lax
